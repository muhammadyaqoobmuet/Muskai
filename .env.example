# Muskai environment variables.
# Copy the relevant parts into apps/api/.env and apps/web/.env.local
# (each app also ships its own .env.example). Never commit a real key.

# --- Backend (apps/api/.env) ---

# Alibaba DashScope (Model Studio, Singapore region) API key.
# Create one in the Model Studio console. Server-side only — never expose it to the browser.
DASHSCOPE_API_KEY=sk-ws-your-key-here

# Port the Express API listens on.
API_PORT=4000

# PostgreSQL connection string (local dev database comes from docker-compose.yml).
DATABASE_URL=postgresql://muskai:muskai_dev@localhost:5432/muskai

# Where generated videos/posters are stored (relative to apps/api).
STORAGE_DIR=./storage

# Optional: public base URL where /files is reachable from the internet.
# DashScope needs to fetch reference/frame images by URL; when this is empty the
# API falls back to sending frames as base64 data URIs.
PUBLIC_FILES_BASE_URL=

# Secret used to sign session cookies (login, auth). At least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Extra browser origins allowed to call the API with cookies, comma separated.
# Use this when the web app runs on a second port or a preview domain.
EXTRA_WEB_ORIGINS=

# --- Frontend (apps/web/.env.local) ---

# Base URL of the Express API, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
