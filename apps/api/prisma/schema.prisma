// Muskai database schema (PostgreSQL).
// Local dev: `docker compose up -d` at the repo root, then `npm run db:setup`.
// Status/mode fields are plain strings validated by @muskai/shared zod schemas
// at the API boundary — the DB stays a dumb, fast store.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered creator. Owns generations and can publish reels publicly.
model User {
  id           String   @id @default(cuid())
  name         String
  /// URL-safe handle derived from the name, unique per user.
  handle       String   @unique
  email        String   @unique
  /// scrypt hash — never leaves the API.
  passwordHash String
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  generations Generation[]
  likes       Like[]
}

/// One user request to generate a reel. Driven by the worker through
/// QUEUED → RUNNING → STITCHING → SUCCEEDED | FAILED.
model Generation {
  id                String    @id @default(cuid())
  /// Owner. Nullable so pre-auth rows (from before accounts existed) survive.
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt            String
  /// User-facing mode from @muskai/shared (TEXT_TO_VIDEO, IMAGE_TO_VIDEO, KEYFRAMES, REFERENCE, EDIT).
  mode              String
  /// Model the user explicitly picked; null = Auto (fallback chain).
  requestedModel    String?
  aspectRatio       String    @default("9:16")
  targetDurationSec Int       @default(10)
  status            String    @default("QUEUED")
  /// Source media supplied by the user (mode-dependent).
  imageUrl          String?
  firstFrameUrl     String?
  lastFrameUrl      String?
  videoUrl          String?
  /// Paths relative to the storage dir, e.g. "<id>/final.mp4". Served via /files.
  outputPath        String?
  posterPath        String?
  errorCode         String?
  errorMessage      String?
  /// Client-generated idempotency key — retries never burn quota twice.
  clientRequestId   String    @unique
  /// Shared publicly on the community feed.
  published         Boolean   @default(false)
  publishedAt       DateTime?
  viewCount         Int       @default(0)
  segments          Segment[]
  likes             Like[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([published, publishedAt])
}

/// A like on a published reel.
model Like {
  userId       String
  generationId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, generationId])
  @@index([generationId])
}


/// One ~5s chunk of a generation. A reel is 1..n segments, stitched in order.
model Segment {
  id              String     @id @default(cuid())
  generationId    String
  generation      Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  index           Int
  /// DashScope model that actually produced this segment (null until run).
  model           String?
  dashscopeTaskId String?
  status          String     @default("PENDING")
  /// For extension segments: the extracted last frame of the previous segment.
  sourceFramePath String?
  /// Path relative to the storage dir, e.g. "<generationId>/seg-0.mp4".
  outputPath      String?
  durationSec     Int        @default(5)
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([generationId, index])
}

/// Per-model free-quota ledger. One row per (model, capability) registry row —
/// wan2.1-vace-plus legitimately appears twice (reference + edit chains) but
/// shares one DashScope pool, so `model` alone is the primary key and usage is
/// counted once per physical pool.
model ModelUsage {
  model             String   @id
  capability        String
  quotaTotal        Int
  unitsObservedUsed Int      @default(0)
  exhausted         Boolean  @default(false)
  lastError         String?
  updatedAt         DateTime @updatedAt
}
