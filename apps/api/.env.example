# Muskai API environment. Copy to .env and fill in the key:  cp .env.example .env

# Alibaba DashScope (Model Studio, Singapore region) API key.
# Server-side only — never expose it to the browser. Leave empty to run the
# API in "no key" mode (health/models work; generations fail gracefully).
DASHSCOPE_API_KEY=

# Port the Express API listens on.
API_PORT=4000

# PostgreSQL connection string. Local dev: start the DB with
# `docker compose up -d` at the repo root — these defaults match it.
DATABASE_URL=postgresql://muskai:muskai_dev@localhost:5432/muskai

# Where generated videos/posters are stored (relative to apps/api).
STORAGE_DIR=./storage

# Optional: public base URL where this API's /files path is reachable from
# the internet. DashScope must fetch reference/frame images by URL; when this
# is empty the API falls back to sending frames as base64 data URIs.
PUBLIC_FILES_BASE_URL=

# Browser origin allowed by CORS (the Next.js dev server).
WEB_ORIGIN=http://localhost:3000

# Secret used to sign session cookies (login, auth). At least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Extra browser origins allowed to call the API with cookies, comma separated.
# Use this when the web app runs on a second port or a preview domain.
EXTRA_WEB_ORIGINS=
